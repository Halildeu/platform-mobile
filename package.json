{
  "name": "platform-mobile",
  "version": "0.1.0",
  "description": "Meeting Intelligence Mobile Client — React Native + Expo + TypeScript",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "contract:ws": "node scripts/validate-ws-stream-contract.js",
    "contract:ws:fetch": "node scripts/validate-ws-stream-contract.js --fetch",
    "test": "jest",
    "test:contracts": "npm run contract:ws && jest src/contracts/__tests__/wsStreamEvents.contract.test.ts --runInBand",
    "test:watch": "jest --watch",
    "test:e2e:ios": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "test:maestro": "maestro test .maestro/",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit -p ios",
    "submit:android": "eas submit -p android",
    "update": "eas update"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-audio": "~0.3.0",
    "expo-auth-session": "~6.0.0",
    "expo-crypto": "~14.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-notifications": "~0.29.0",
    "expo-local-authentication": "~15.0.0",
    "expo-linking": "~7.0.0",
    "expo-localization": "~16.0.0",
    "expo-updates": "~0.27.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-gesture-handler": "~2.20.0",
    "@reduxjs/toolkit": "^2.5.0",
    "react-redux": "^9.2.0",
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@types/jest": "^29.5.0",
    "typescript": "^5.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "@testing-library/react-native": "^12.9.0",
    "react-test-renderer": "18.3.1",
    "detox": "^20.28.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.0",
    "prettier": "^3.4.0"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
