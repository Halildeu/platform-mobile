{
  "expo": {
    "name": "Workcube Meeting",
    "slug": "workcube-meeting",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workcube",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workcube.meeting",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Workcube Meeting toplantı sesini transkripte dönüştürmek için mikrofon erişimine ihtiyaç duyar. KVKK kapsamında ses kaydı şifrelenir ve toplantı sahibinin onayıyla işlenir.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.workcube.meeting",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Workcube Meeting toplantı sesini transkripte dönüştürmek için mikrofon erişimine ihtiyaç duyar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "router": {
        "origin": false
      }
    },
    "owner": "halildeu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/UPDATE_PROJECT_ID"
    }
  }
}
