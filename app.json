{
  "expo": {
    "name": "Workcube Meeting",
    "slug": "workcube-meeting",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workcube",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workcube.meeting",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Workcube Meeting toplantı sesini transkripte dönüştürmek için mikrofon erişimine ihtiyaç duyar. KVKK kapsamında ses kaydı şifrelenir ve toplantı sahibinin onayıyla işlenir.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.workcube.meeting",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Workcube Meeting toplantı sesini transkripte dönüştürmek için mikrofon erişimine ihtiyaç duyar."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3597d06c-21ec-4908-b453-e72f219d5758"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "serban1245",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
